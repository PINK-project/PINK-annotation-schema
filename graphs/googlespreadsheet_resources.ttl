    dcterms:description "The toxicological category includes only one profiler. The profiler contains boundaries based on repeated dose toxicity test data extracted from database of Hazard Evaluation Support System (HESS)."@en ;
    rdfs:subClassOf ssbd:Profiler .

<https://w3id.org/pink/activity/activity0> a owl:Class ;
    dcterms:title """MultiCASE CASE Ultra commercial model RC2_AF4 for Rodent carcinogenicity in female mouse in vivo,
Danish QSAR Group at DTU Food"""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue pink:e2078536-1427-4d94-88dc-766215ea9abb ;
            owl:onProperty ssbd:hasSoftware ],
        [ a owl:Restriction ;
            owl:hasValue qsar:CarcinogenicityPotential ;
            owl:onProperty ssbd:hasOutput ],
        [ a owl:Restriction ;
            owl:onProperty ssbd:hasInput ;
            owl:someValuesFrom datasettype:SMILES ],
        prov:Activity,
        ssbd:CarcinogenicityAssessment,
        ssbd:Computation,
        ssbd:HazardAssessmentHumanHealth,
        ssbd:SafetyAssessment .

<https://w3id.org/pink/activity/activity1> a owl:Class ;
    dcterms:title "Tox21 HEK293T Gonadotropin-releasing Hormone (GnRH) Receptor Agonism Assay"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <tox21:10kCompoundLibrary> ;
            owl:onProperty ssbd:hasInput ],
        [ a owl:Restriction ;
            owl:hasValue pink:TOX21_GNRHR_HEK293_Agonist ;
            owl:onProperty ssbd:hasSoftware ],
        prov:Activity,
        ssbd:Computation,
        ssbd:EndocrineToxicityAssessment,
        ssbd:ExposureAssessmentHumanHealth,
        ssbd:SafetyAssessment .

<https://w3id.org/pink/activity/activity10> a owl:Class ;
    dcterms:title "CNR force field builder module - molecular scale"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ssbd:hasInput ;
            owl:someValuesFrom datasettype:ChemicalStructureDataset ],
        [ a owl:Restriction ;
            owl:hasValue mw:ff_builder_molecular ;
            owl:onProperty ssbd:hasSoftware ],
        [ a owl:Restriction ;
            owl:onProperty ssbd:hasOutput ;
            owl:someValuesFrom datasettype:InteractionPotentialParameters ],
        prov:Activity,
        ssbd:Computation,
        ssbd:FunctionalityAssessment .

<https://w3id.org/pink/activity/activity11> a owl:Class ;
    dcterms:title "CNR bulk builder module - molecular scale"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue mw:polymer_bulk_builder_molecular ;
            owl:onProperty ssbd:hasSoftware ],
        [ a owl:Restriction ;
            owl:onProperty ssbd:hasOutput ;
