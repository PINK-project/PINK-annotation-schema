        [ a owl:Restriction ;
            owl:hasValue mw:mechanical_properties_evaluator_molecular ;
            owl:onProperty ssbd:hasSoftware ],
        [ a owl:Restriction ;
            owl:onProperty ssbd:hasInput ;
            owl:someValuesFrom datasettype:ChemicalStructureDataset ],
        prov:Activity,
        ssbd:BulkModulusAssessment,
        ssbd:Computation,
        ssbd:DensityAssessment,
        ssbd:FunctionalityAssessment,
        ssbd:GlassTransitionTemperatureAssessment,
        ssbd:MechanicalPropertiesAssessment,
        ssbd:PhysicalPropertiesAssessment,
        ssbd:PoissonsRatioAssessment,
        ssbd:ThermalPropertiesAssessment,
        ssbd:YoungsModulusAssessment .

<https://w3id.org/pink/activity/activity14> a owl:Class ;
    dcterms:title "AOP 451: Interaction with lung resident cell membrane components leads to lung cancer"@en ;
