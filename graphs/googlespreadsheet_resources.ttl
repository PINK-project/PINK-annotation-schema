pink:Jaqpot_2081 a [ a owl:Restriction ;
            owl:onProperty ssbd:implementsModel ;
            owl:someValuesFrom ssbd:RandomForest ],
        ssbd:Software ;
    dcterms:accessRights rights:PUBLIC ;
    dcterms:creator <https://ror.org/03cx6bg69> ;
    dcterms:description """The endpoint predicted by this model is Animal Carcinogenicity. The dataset used for modeling was obtained from the Carcinogenic Potency Database (CPDB), which contains long-term study results for over 1,500 chemical substances on rodent (mouse and rat) species. Carcinogenicity is defined through the OECD Test No. 451. Each author in the literature evaluated the tissue-tumor combination of the chemical substance and gave their opinion on carcinogenicity, which was assessed from NCI/NTP. In the dataset:
Carcinogenic chemicals are labeled as 1.
Non-carcinogenic chemicals are labeled as 0."""@en ;
    dcterms:title "Animal Carcinogenicity prediction according to OECD Test No. 451"@en ;
    dcat:distribution [ a owl:NamedIndividual,
                dcat:Distribution,
                dcat:Resource ;
            dcat:accessURL "https://app.jaqpot.org/dashboard/models/2081/description"^^xsd:anyURI ] ;
    ddoc:curator <https://orcid.org/0000-0002-0628-8434> ;
    ssbd:documentation <https://docs.google.com/document/d/1yBrGi-dJkPBCYkpQ6qhCtzQswdLcKN5x/edit?usp=drive_link&ouid=103056225293934767525&rtpof=true&sd=true> ;
    ssbd:hasAPI true ;
    ssbd:hasGUI true .

pink:Jaqpot_2082 a ssbd:Software ;
    dcterms:accessRights rights:PUBLIC ;
    dcterms:creator <https://ror.org/03cx6bg69> ;
    dcterms:description "Binary Classification of Skin Reaction for small Drugs with Extra Trees Classifier and MACCS fingerprints with python and jaqpot software. An Extra Trees classifier was developed to classify whether a drug causes skin reaction or not. The dataset used in this study was retrieved from the ICCVAM (Interagency Coordinating Committee on the Validation of Alternative Methods) report on the rLLNA. The test used to obtain the endpoint is called reduced LLNA (rLLNA) which identifies skin sensitizers by quantifying lymphocyte proliferation.. The train and testing splits were conducted randomly stratified with a 0.7-0.3 ratio. MACCS fingerprints were generated from SMILES and feature selection through correlation, variance threshold and mutual information was implemented. The final model is cross-validated and evaluated on the unseen test set to ensure robustness."@en ;
    dcterms:title "Skin Reaction TDCommons"@en ;
    dcat:distribution [ a owl:NamedIndividual,
                dcat:Distribution,
                dcat:Resource ;
            dcat:accessURL "https://app.jaqpot.org/dashboard/models/2082/description"^^xsd:anyURI ] ;
    ddoc:curator <https://orcid.org/0000-0002-0628-8434> ;
    ssbd:documentation <https://docs.google.com/document/d/1F0iwM70_BLwXiBPRN9J5PDtuV8UJLdoC/edit> ;
    ssbd:hasAPI true ;
    ssbd:hasGUI true ;
    ssbd:implementsModel pink:ExtraTreeClassifier .

