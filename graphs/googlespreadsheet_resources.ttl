@prefix datasettype: <https://pink-project.eu/datasettype/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ddoc: <https://w3id.org/emmo/application/datadoc#> .
@prefix emmo: <https://w3id.org/emmo/hume#> .
@prefix empa: <https://empa.ch/> .
@prefix empadm: <https://empa.ch/datamodel/> .
@prefix mw: <https://modelwave.it/> .
@prefix omics: <http://pink-project.eu/omics/> .
@prefix oteio: <https://w3id.org/emmo/domain/oteio#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pink: <https://pink-project.eu/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qsar: <https://pink-project.eu/qsar/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rights: <http://publications.europa.eu/resource/authority/access-right/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ssbd: <https://w3id.org/ssbd/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

omics:transcriptPTGS-BMDoutput a owl:Class ;
    rdfs:label "transcriptPTGS-BMDoutput"@en ;
    dcterms:description "missing"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <https://ror.org/056d84691> ;
            owl:onProperty ddoc:curator ] .

pink:ChemPharosDB-ds10 a owl:Class ;
    rdfs:label "Boiling point of small molecules"@en ;
    dcterms:description "A curated and enriched dataset for the boiling point (BP) in °C of small molecules, intended for in silico model development. The dataset originates from the US EPA EPI Suite, filtered according to Zang et al. (2017). https://doi.org/10.1021/acs.jcim.6b00625. The curated BP dataset comprises 5432 compounds enriched with 777 molecular descriptors extracted from their 2D structure using EnalosMold2 KNIME node."@en ;
    dcterms:format ".csv" ;
    rdfs:subClassOf ssbd:Dataset .

pink:ChemPharosDB-ds11 a owl:Class ;
    rdfs:label "Ames mutagenicity of small molecule"@en ;
    dcterms:description "A curated and enriched dataset for the Ames mutagenicity of small molecules, intended for in silico model development. The dataset originates from the study of Hansen et al. (2009) https://doi.org/10.1021/ci900161g, and is further refined by the US EPA EPI Suite (removing salts, mixtures, ambiguous compounds, and compounds without CAS numbers). The curated lmutagenicity dataset comprises 5738 compounds enriched with 777 molecular descriptors extracted from their 2D structure using EnalosMold2 KNIME node. Compounds are classified as either “positive” -indicating mutagenic compounds- or “negative” -indicating non-mutagenic substances."@en ;
    dcterms:format ".csv" ;
    rdfs:subClassOf ssbd:Dataset .

pink:ChemPharosDB-ds3 a owl:Class ;
    rdfs:label "Vapor Pressure (logVP) of small molecules"@en ;
    dcterms:description "A curated and enriched dataset for log-transormed vapor pressure at 24˚C of small molecules, intended for in silico model development. The dataset originates from the US EPA EPI Suite, filtered according to Zang et al. (2017). https://doi.org/10.1021/acs.jcim.6b00625. The curated logVP dataset comprises 2713 compounds enriched with 777 molecular descriptors extracted from their 2D structure using EnalosMold2 KNIME node."@en ;
    dcterms:format ".csv" ;
    rdfs:subClassOf ssbd:Dataset .

pink:ChemPharosDB-ds4 a owl:Class ;
    rdfs:label "Octanol/water partition coefficient (logP) of small molecules"@en ;
    dcterms:description "A curated and enriched dataset for log-transormed octanol/water partition coefficient of small molecules, intended for in silico model development. The dataset originates from the US EPA EPI Suite, filtered according to Zang et al. (2017). https://doi.org/10.1021/acs.jcim.6b00625. The curated logP dataset comprises 14207 compounds enriched with 777 molecular descriptors extracted from their 2D structure using EnalosMold2 KNIME node."@en ;
    dcterms:format ".csv" ;
    rdfs:subClassOf ssbd:Dataset .

pink:ChemPharosDB-ds5 a owl:Class ;
    rdfs:label "Cytotoxicity of small molecules"@en ;
    dcterms:description "A curated and enriched dataset for the cytotoxicity of small molecules to NIH/3T3 cells (mouse embryonic fibroblast cell line; ATCC CRL-1658). The dataset originates from the PubChem database: https://pubchem.ncbi.nlm.nih.gov/bioassay/651744. The curated dataset comprises 5416 compounds enriched with 777 molecular descriptors extracted from their 2D structure using EnalosMold2 KNIME node. Compounds are classified as either “Active”—indicating cytotoxicity to NIH/3T3 cells—or “Inactive”, signifying non-cytotoxicity to these cells."@en ;
    dcterms:format ".csv" ;
    rdfs:subClassOf ssbd:Dataset .

datasettype:ChemicalStructureCoordinateDataset a owl:Class ;
    rdfs:label "Chemical Structure Coordinate Dataset"@en ;
    dcterms:description "Dataset describing a three-dimensional coordinates of a structure."@en ;
    dcterms:format "MOL, SDF, PDB, XYZ, GRO, CIF" ;
    rdfs:subClassOf datasettype:ChemicalStructureDataset .

datasettype:Ecotoxicity_Daphnia a owl:Class ;
    rdfs:label "Acute (48h, immobilisation) or chronic (21-day, reproduction) impacts on D. magna"@en ;
    dcterms:description "Data for acute (48h, immobilisation) or chronic (21-day, reproduction) of D. magna by specific nanomaterials or chemicals"@en ;
    dcterms:format ".csv" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <https://ror.org/03angcq70> ;
            owl:onProperty ddoc:curator ],
        ssbd:Dataset ;
    dcat:keyword "Daphnia magna"@en,
        "acute"@en,
        "chronic"@en,
        "ecotoxicity"@en,
        "nanomaterials"@en .

datasettype:Ecotoxicity_ZebrafishEmbryoCells a owl:Class ;
    rdfs:label "Ecotoxicity_ZebrafishEmbryoCells"@en ;
    dcterms:description "Detailed mechanistic information on impacts of PFAS alone or as mixtures on ZF4 cell viability, cell death mechanism, metabolic pathways and mitochondrial toxicity."@en ;
    dcterms:format ".csv" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <https://ror.org/03angcq70> ;
            owl:onProperty ddoc:curator ],
        ssbd:Dataset ;
    dcat:keyword "PFAS"@en,
        "PFAS mixtures"@en,
        "Zebrafish embryo cells"@en,
        "ecotoxicity"@en,
        "mode of action"@en .

datasettype:OccurrenceData a owl:Class ;
    rdfs:label "Quantification of PFAS in surface and groundwater sites in UK"@en ;
    dcterms:description "A curated dataset of environmental monitoring from UK 2022-2024 for surface and groundwaters assessing total PFAS and individual PFAS congeners."@en ;
    dcterms:format ".csv" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <https://ror.org/03angcq70> ;
            owl:onProperty ddoc:curator ],
        ssbd:Dataset ;
    dcat:keyword "GIS-tagged data"@en,
        "PFAS"@en,
        "persistant organic pollutnats"@en .

datasettype:chemicalExposureQuantifiedSeries a owl:Class ;
    rdfs:label "Quantity of a chemical applied in a toxicology experiment"@en ;
    dcterms:description "Quantity of a chemical applied in a toxicology experiment"@en ;
    dcterms:format "csv" ;
    dcat:keyword "toxicity"@en .

