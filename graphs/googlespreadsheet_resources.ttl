            owl:someValuesFrom datasettype:InteractionPotentialParameters ],
        prov:Activity,
        ssbd:Computation,
        ssbd:FunctionalityAssessment .

<https://w3id.org/pink/activity/activity12> a owl:Class ;
    dcterms:title "CNR Young's modulus calculator module - molecular scale"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ssbd:hasInput ;
            owl:someValuesFrom datasettype:InteractionPotentialParameters ],
        [ a owl:Restriction ;
            owl:hasValue mw:youngs_modulus_evaluator_molecular ;
            owl:onProperty ssbd:hasSoftware ],
        [ a owl:Restriction ;
            owl:onProperty ssbd:hasInput ;
            owl:someValuesFrom datasettype:ChemicalStructureDataset ],
        [ a owl:Restriction ;
            owl:onProperty ssbd:hasOutput ;
            owl:someValuesFrom datasettype:MechanicalPropertiesDataset ],
        prov:Activity,
        ssbd:Computation,
        ssbd:FunctionalityAssessment,
        ssbd:MechanicalPropertiesAssessment,
        ssbd:PhysicalPropertiesAssessment,
        ssbd:ThermalPropertiesAssessment .

<https://w3id.org/pink/activity/activity13> a owl:Class ;
    dcterms:title "CNR mechanical properties calculator module - molecular scale"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ssbd:hasOutput ;
            owl:someValuesFrom datasettype:MechanicalPropertiesDataset ],
        [ a owl:Restriction ;
            owl:onProperty ssbd:hasInput ;
