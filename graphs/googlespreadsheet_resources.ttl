    dcterms:accessRights rights:PUBLIC ;
    dcterms:creator <https://ror.org/03wwn0z54> ;
    dcterms:description "This web GUI tool calculates the Hamaker constant of two different types of Nanoparticles in dispersion medium using the NOVAMFF (i.e., a FF for the accurate prediction of Hamaker constants). The NP's chemical formulas and the chemical formula of the dispersion medium as well astheir densities are needed as input by the user"@en ;
    dcterms:title "Hamaker Extended tool"@en ;
    dcat:distribution [ a owl:NamedIndividual,
                dcat:Distribution,
                dcat:Resource ;
            dcat:accessURL "https://enaloscloud.novamechanics.com/pinkish/hamakerextension/"^^xsd:anyURI ] ;
    dcat:keyword "Aggregation"@en,
        "DLVO"@en,
        "NPs"@en ;
    ssbd:hasAPI true ;
    ssbd:hasGUI true .

pink:EnalosCloud_NanoBioConstruct a [ a owl:Restriction ;
            owl:onProperty ssbd:chemicalClass ;
            owl:someValuesFrom ssbd:NanoParticle ],
        [ a owl:Restriction ;
            owl:onProperty ssbd:chemicalClass ;
            owl:someValuesFrom ssbd:Protein ],
        ssbd:Software ;
    dcterms:accessRights rights:PUBLIC ;
    dcterms:creator <https://ror.org/03wwn0z54> ;
    dcterms:description "This web GUI tool prioritirize human proteins based on their adsorption onto a wide range of NPs surface using the UnitedAtom approach and Debye Theory and then applies a mapping from the coarse-grained approximation of the produced NP-protein configurations to atomistic ones in order to calculate with accuracy the NP's protein corona and calculate its adsorption energy"@en ;
    dcterms:title "NanoBioConstruct"@en ;
    dcat:keyword "Aggregation"@en,
        "Atomistic Calculations"@en,
        "DLVO"@en,
        "Inverse Mapping"@en,
        "NPs"@en ;
    ssbd:hasGUI true .

pink:EnalosCloud_PINK_ChemInformatics_Suite a [ a owl:Restriction ;
            owl:onProperty ssbd:chemicalClass ;
            owl:someValuesFrom ssbd:MicroMolecule ],
        ssbd:Software ;
    dcterms:accessRights rights:PUBLIC ;
    dcterms:creator <https://ror.org/03wwn0z54> ;
    dcterms:description "Within this web-tool, users can import compounds of interest by either drawing molecules using an integrated sketcher or uploading a list of molecules in SMILES format. Users can also inspect a 3D visualization of their molecular structures post-drawing. The platform can be used for high-throughput virtual screening through batch processing: users can upload SDF files and process multiple compounds with one query. Then the users should select one or more endpoints from the available checkbox list (i.e., logP, logVP, BP, Cytotoxicity, Mutagenicity). Upon submission, predictions are generated within seconds. The results include the predicted property value(s) and/or toxicity class. All results can be downloaded per model for further analysis, enhancing flexibility and usability for diverse research applications. Apart from the predictions for each model their reliability according to the corresponding applicability domain is presented. Especially for the developed kNN models, in the downloaded results the training neighbours and their distances from the input substances are presented, allowing the evaluation of structural similarity patterns."@en ;
    dcterms:title "PINK ChemInformatics Suite"@en ;
    dcat:distribution [ a owl:NamedIndividual,
                dcat:Distribution,
                dcat:Resource ;
            dcat:accessURL "https://www.enaloscloud.novamechanics.com/pinkish/suite/index.zul"^^xsd:anyURI ] ;
    dcat:keyword "BP"@en,
        "Cytotoxicity"@en,
        "ML"@en,
        "Mutagenicity"@en,
        "logP"@en,
        "logVP"@en ;
    ssbd:documentation <https://www.enaloscloud.novamechanics.com/pinkish/suite> ;
    ssbd:hasGUI true .

