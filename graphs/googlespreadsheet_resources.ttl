datasettype:ChemicalStructureDataset a owl:Class ;
    rdfs:label "Chemical Structure Dataset"@en ;
    dcterms:description "Dataset describing the chemical identity and three-dimensional structure of molecules, oligomers, polymers, or condensed-phase systems. It may include SMILES strings, atomistic coordinates, bonding topology, periodic boundary conditions, and molecular connectivity. The dataset is used as input for structure generation, force-field assignment, molecular dynamics simulations, and construction of bulk models."@en ;
    dcterms:format "SMILES, MOL, SDF, PDB, XYZ, GRO, CIF" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <https://ror.org/04zaypm56> ;
            owl:onProperty ddoc:curator ],
        ssbd:Dataset ;
    dcat:keyword "SMILES"@en,
        "atomistic model"@en,
        "chemical structure"@en,
        "coordinates"@en,
        "molecular structure"@en,
        "periodic system"@en,
        "polymer chain"@en,
        "topology"@en .

