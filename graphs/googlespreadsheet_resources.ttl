datasettype:MechanicalPropertiesDataset a owl:Class ;
    rdfs:label "Mechanical Properties Dataset"@en ;
    dcterms:description "Dataset reporting mechanical properties derived from experiments or simulations, such as Young’s modulus, bulk modulus, Poisson’s ratio, stress-strain curves, elastic constants, and derived statistical indicators. The dataset supports quantitative assessment of material stiffness, elasticity, and macroscopic mechanical behavior."@en ;
    dcterms:format "CSV, XLSX, JSON" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <https://ror.org/04zaypm56> ;
            owl:onProperty ddoc:curator ],
        ssbd:Dataset ;
