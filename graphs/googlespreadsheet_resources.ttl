    dcterms:accessRights rights:PUBLIC ;
    dcterms:creator <https://ror.org/03tns0030> ;
    dcterms:description "TOX21_GNRHR_HEK293 is a cell-based, single-readout assay that uses GnRHR-expressing stably transfected HEK293, a human kidney cell line, with measurements taken at 1.25 hours after chemical dosing in a 1536-well plate. TOX21_GNRHR_HEK293_Agonist is one of 2 assay components measured in the TOX21_GNRHR_HEK293 assay. It is designed to make measurements of intracellular calcium, a form of biochemical reporter, as detected with Fluorescence intensity signals by FDSS 7000EX kinetic plate reader technology. Data from the assay component TOX21_GNRHR_HEK293_Agonist was analyzed into 2 assay endpoints. This assay endpoint, TOX21_GNRHR_HEK293_Agonist was analyzed in the positive analysis fitting direction relative to DMSO as the negative control and baseline of activity. Using a type of inducible reporter, gain-of-signal activity can be used to understand changes in binding. To generalize the intended target to other relatable targets, this assay endpoint is annotated to the gpcr, where the subfamily is gonadotropin-releasing hormone receptor."@en ;
    dcterms:license <http://www.usa.gov/publicdomain/label/1.0/> ;
    dcterms:rightsHolder <https://ror.org/03tns0030> ;
    dcterms:title "Tox21 HEK293T Gonadotropin-releasing Hormone (GnRH) Receptor Agonism Assay"@en ;
    dcat:distribution [ a owl:NamedIndividual,
                dcat:Distribution,
                dcat:Resource ;
            dcat:accessURL "https://clowder.edap-cluster.com/spaces/687e388ce4b02565bc3e28e4"^^xsd:anyURI ;
            dcat:downloadURL "https://doi.org/10.23645/epacomptox.6062623"^^xsd:anyURI ] ;
    dcat:version "ToxCast Database: invitrodb version 4.3" ;
    ddoc:curator <https://orcid.org/0000-0002-1849-5246> ;
    ssbd:documentation <https://clowder.edap-cluster.com/files/68a37cece4b02565fc7b59e4?dataset=6894f2dae4b025654d12b716&space=687e388ce4b02565bc3e28e4> ;
    ssbd:hasAPI true ;
    ssbd:hasGUI true ;
    ssbd:inTierLevel ssbd:tierlevel1 .

