qsar:ProfilerOutputCustom a owl:Class ;
    rdfs:label "Custom QSAR profilers"@en ;
    dcterms:description "schemes based on the user`s knowledge. Example Prioritization Scheme (PBT) identifying the persistence, bioaccumulation and toxicity of the target chemical(s) based on their experimental and/or predicted data is included as a custom profiler."@en ;
    rdfs:subClassOf ssbd:Profiler .

