mw:bulk_polymer_mechanical_molecular a [ a owl:Restriction ;
            owl:onProperty ssbd:chemicalClass ;
            owl:someValuesFrom emmo:PolymericMaterial ],
        ssbd:Software ;
    dcterms:accessRights rights:PUBLIC ;
    dcterms:creator <https://ror.org/04zaypm56> ;
    dcterms:description "(Integrated workflow) - An integrated workflow based on atomistic molecular dynamics simulations that uses the SMILES representation of a monomer as input to automatically generate a polymer chain, construct a periodic bulk model, and perform fully atomistic simulations of mechanical properties. From the stress-strain response obtained under controlled deformation, the tool computes the key mechanical properties of the polymer, including Young’s modulus, bulk modulus, and Poisson’s ratio."@en ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:title "CNR SMILES to mechanical properties workflow - molecular scale"@en ;
    dcat:keyword "Molecular dynamics"@en,
        "SMILES"@en,
        "bulk"@en,
        "polymer"@en ;
    ddoc:curator <https://orcid.org/0000-0002-3369-4438>,
        <https://orcid.org/0000-0002-4860-153X> ;
    ssbd:hasAPI true ;
    ssbd:hasGUI true ;
    ssbd:inTierLevel ssbd:tierlevel1 .

mw:ff_builder_molecular a [ a owl:Restriction ;
            owl:onProperty ssbd:chemicalClass ;
            owl:someValuesFrom emmo:PolymericMaterial ],
        [ a owl:Restriction ;
            owl:onProperty ssbd:implementsModel ;
            owl:someValuesFrom emmo:AtomicInteractionModel ],
        ssbd:Software ;
    dcterms:accessRights rights:PUBLIC ;
    dcterms:creator <https://ror.org/04zaypm56> ;
    dcterms:description "(Computational module) - This module takes the polymer structure as an input and generates a molecular mechanics force field, with OPLS used as the default option and GAFF available as an alternative. The tool generates the complete molecular topology, including atom types, bonded and non-bonded parameters, partial charges, and connectivity, providing a fully parameterized polymer structure ready for subsequent MD calculations."@en ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:title "CNR force field builder module - molecular scale"@en ;
    dcat:keyword "Molecular dynamics"@en,
        "force field"@en,
        "polymer"@en,
        "topology"@en ;
    ddoc:curator <https://orcid.org/0000-0002-3369-4438>,
        <https://orcid.org/0000-0002-4860-153X> ;
    ssbd:hasAPI true ;
    ssbd:hasGUI true ;
    ssbd:inTierLevel ssbd:tierlevel1 .

mw:mechanical_properties_evaluator_molecular a [ a owl:Restriction ;
            owl:onProperty ssbd:implementsModel ;
            owl:someValuesFrom emmo:AtomisticMolecularDynamics ],
        [ a owl:Restriction ;
            owl:onProperty ssbd:chemicalClass ;
            owl:someValuesFrom emmo:PolymericMaterial ],
        ssbd:Software ;
    dcterms:accessRights rights:PUBLIC ;
    dcterms:creator <https://ror.org/04zaypm56> ;
    dcterms:description "(Computational module) - This module takes the equilibrated bulk polymer model as input and prepares it for mechanical testing by replicating the simulation cell and applying a series of molecular dynamics simulations. Controlled deformations are introduced under NPT conditions to obtain stress-strain responses for different loading modes. From these trajectories, the module computes key mechanical indicators of the polymer, including Young’s modulus, bulk modulus, and Poisson’s ratio, providing a quantitative assessment of the material’s macroscopic mechanical behavior directly from atomistic simulation."@en ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:title "CNR mechanical properties calculator module - molecular scale"@en ;
    dcat:keyword "bulk modulus"@en,
        "molecular dynamics"@en,
        "poisson ratio"@en,
        "polymer"@en,
        "young's modulus"@en ;
    ddoc:curator <https://orcid.org/0000-0002-3369-4438>,
        <https://orcid.org/0000-0002-4860-153X> ;
    ssbd:hasAPI true ;
    ssbd:hasGUI true ;
    ssbd:inTierLevel ssbd:tierlevel1 .

mw:polymer_builder_molecular a [ a owl:Restriction ;
            owl:onProperty ssbd:implementsModel ;
            owl:someValuesFrom emmo:StructureManipulationModel ],
        [ a owl:Restriction ;
            owl:onProperty ssbd:chemicalClass ;
            owl:someValuesFrom emmo:PolymericMaterial ],
        ssbd:Software ;
    dcterms:accessRights rights:PUBLIC ;
    dcterms:creator <https://ror.org/04zaypm56> ;
    dcterms:description "(Computational module) - This module takes the SMILES representation of a monomer as input and automatically generates a polymer chain structure (atomistic level) suitable for atomistic molecular dynamics simulations. The tool interprets the SMILES string to reconstruct the 3D molecular structure of the monomer, identifies the reactive termini, and performs automated polymerization to build a chain of user-defined length."@en ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:title "CNR polymer builder module - molecular scale"@en ;
    dcat:keyword "SMILES"@en,
        "polymer"@en ;
    ddoc:curator <https://orcid.org/0000-0002-3369-4438>,
        <https://orcid.org/0000-0002-4860-153X> ;
    ssbd:hasAPI true ;
    ssbd:hasGUI true ;
    ssbd:inTierLevel ssbd:tierlevel1 .

mw:polymer_bulk_builder_molecular a [ a owl:Restriction ;
            owl:onProperty ssbd:implementsModel ;
            owl:someValuesFrom emmo:AtomisticMolecularDynamics ],
        [ a owl:Restriction ;
            owl:onProperty ssbd:chemicalClass ;
            owl:someValuesFrom emmo:PolymericMaterial ],
        [ a owl:Restriction ;
            owl:onProperty ssbd:chemicalClass ;
            owl:someValuesFrom emmo:OrganicCompound ],
        ssbd:Software ;
    dcterms:accessRights rights:PUBLIC ;
    dcterms:creator <https://ror.org/04zaypm56> ;
    dcterms:description "(Computational module) - This module takes a single polymer chain structure (atomistic level) as an input and constructs a three-dimensional bulk model (atomistic level) by replicating it within a cubic simulation box. The system is then subjected to a multi-stage molecular dynamics protocol in the NPT ensemble, comprising heating under compression, cooling under compression, and final equilibration at ambient pressure. This procedure enables the chains to pack realistically and relax toward a stable glassy configuration. The module outputs the equilibrated bulk structure along with key bulk properties extracted from the simulation, providing a physically meaningful starting point for mechanical characterization."@en ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:title "CNR bulk builder module - molecular scale"@en ;
    dcat:keyword "bulk"@en,
        "density"@en,
        "molecular dynamics"@en,
        "polymer"@en ;
    ddoc:curator <https://orcid.org/0000-0002-3369-4438>,
        <https://orcid.org/0000-0002-4860-153X> ;
    ssbd:hasAPI true ;
    ssbd:hasGUI true ;
    ssbd:inTierLevel ssbd:tierlevel1 .

mw:youngs_modulus_evaluator_molecular a [ a owl:Restriction ;
            owl:onProperty ssbd:chemicalClass ;
            owl:someValuesFrom emmo:PolymericMaterial ],
        [ a owl:Restriction ;
            owl:onProperty ssbd:implementsModel ;
            owl:someValuesFrom emmo:AtomisticMolecularDynamics ],
        ssbd:Software ;
    dcterms:accessRights rights:PUBLIC ;
    dcterms:creator <https://ror.org/04zaypm56> ;
    dcterms:description "(Computational module) -This module computes the Young’s modulus of a bulk polymer system using molecular simulations. It takes as input an equilibrated polymer configuration along with the corresponding interaction parameters. The simulation cell is replicated to minimize finite-size effects and subjected to controlled uniaxial deformation within an NPT ensemble. During deformation, the stress-strain response of the system is recorded. The Young’s modulus is then determined by fitting the linear elastic region of the stress-strain curve, providing a quantitative measure of the polymer’s mechanical stiffness."@en ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:title "CNR Young's modulus calculator module - molecular scale"@en ;
    dcat:keyword "mechanical properties"@en,
        "molecular dynamics"@en,
        "polymer"@en,
        "young's modulus"@en ;
    ddoc:curator <https://orcid.org/0000-0002-3369-4438>,
        <https://orcid.org/0000-0002-4860-153X> ;
    ssbd:hasAPI true ;
    ssbd:hasGUI true ;
    ssbd:inTierLevel ssbd:tierlevel1 .

