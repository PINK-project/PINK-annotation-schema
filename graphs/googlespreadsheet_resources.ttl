        "Young’s modulus"@en,
        "bulk modulus"@en,
        "elastic constants"@en,
        "material characterization"@en,
        "mechanical properties"@en,
        "stress-strain"@en .

datasettype:InteractionPotentialParameters a owl:Class ;
    rdfs:label "Interaction Potential Parameters Dataset"@en ;
    dcterms:description "Dataset containing the parameters required to define the interaction potential for molecular simulations. This includes atom types, bonded parameters (bonds, angles, dihedrals), non-bonded parameters (Lennard-Jones, electrostatics), partial charges, and force-field topology information. The dataset enables reproducible molecular mechanics and molecular dynamics simulations."@en ;
    dcterms:format "TOP, ITP, PRM, XML, JSON, TXT" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <https://ror.org/04zaypm56> ;
            owl:onProperty ddoc:curator ],
        ssbd:Dataset ;
    dcat:keyword "GAFF"@en,
        "OPLS"@en,
        "atom types"@en,
        "bonded parameters"@en,
        "force field"@en,
        "interaction potential"@en,
        "non-bonded parameters"@en,
        "partial charges"@en,
        "topology"@en .

